#!/bin/sh
# Runs the sanitizer on the commits being pushed, before they leave this
# clone. Turn it on once per clone:
#
#   git config core.hooksPath .githooks
#
# The hook needs SANITIZE_DENYLIST set to your deny-list file. CI runs the
# same checks, so it is the backstop for a clone without the hook.

set -u

root="$(git rev-parse --show-toplevel)" || exit 1
cd "$root" || exit 1

status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  : "$local_ref" "$remote_ref"
  case "$local_sha" in
    *[!0]*) ;;
    *) continue ;; # A branch deletion pushes no commits.
  esac
  case "$remote_sha" in
    *[!0]*) range="$remote_sha..$local_sha" ;;
    *)
      # A new branch: scan what origin/main does not hold yet.
      if git rev-parse --verify --quiet origin/main >/dev/null; then
        range="origin/main..$local_sha"
      else
        range="$local_sha"
      fi
      ;;
  esac
  npm run --silent sanitize -- --range "$range" || status=1
done

exit "$status"
